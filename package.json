{
  "name": "tmuxscope",
  "version": "0.1.2",
  "description": "One tmux session per project scope, one scope per session.",
  "type": "module",
  "bin": {
    "tmuxscope": "dist/tmuxscope"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun build --compile ./src/cli.ts --outfile dist/tmuxscope",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fayez-nazzal/tmuxscope.git"
  },
  "keywords": [
    "tmux",
    "sessions",
    "zsh",
    "cli",
    "workspace"
  ]
}
