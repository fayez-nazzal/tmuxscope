{
  "name": "tmuxscope",
  "version": "0.2.1",
  "description": "A tmux and shell setup tool. One tmux session per project scope, one scope per directory, checked and repaired on demand.",
  "type": "module",
  "bin": {
    "tmuxscope": "dist/tmuxscope"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun build --compile ./src/cli.ts --outfile dist/tmuxscope",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fayez-nazzal/tmuxscope.git"
  },
  "keywords": [
    "ai-agents",
    "agent-tools",
    "claude-code",
    "codex",
    "antigravity",
    "grok-cli",
    "cursor",
    "opencode",
    "agentic",
    "cli",
    "tmux",
    "tmux-session",
    "sessions",
    "zsh",
    "workspace",
    "developer-tools"
  ]
}
